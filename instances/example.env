# Copy to <name>.env and edit. One file per CONTAINER: a single store
# (STORAGE_URI or VOLUME) or a registry (MEMORA_DATABASES) that serves
# every workspace from this container by URL path (/mcp/<name>).
#
# load() requires at least one of STORAGE_URI, VOLUME, MEMORA_DATABASES.
# If more than one is set, up uses DATABASES, then STORAGE_URI, then VOLUME.

INSTANCE=example            # container becomes memora-<INSTANCE>
PORT=8910                   # host port the proxy listens on (127.0.0.1:<PORT>)

# Backend — at least one:
STORAGE_URI="d1://ACCOUNT_ID/DATABASE_ID"   # quoted: bare <> would be a shell redirect
# VOLUME=$HOME/path/to/data # local sqlite instead; mounted at /data
# MEMORA_DATABASES='{"memora":"d1://ACCOUNT/DB1","ob1":"d1://ACCOUNT/DB2"}'
# MEMORA_DEFAULT_DB=memora  # required when the registry has more than one name

# Optional:
# CONTAINER=some-name       # adopt a container created under another name
# IMAGE=memora              # pin this instance to its own image tag
# CRED_SOURCE=$HOME/.config/memora/example.credentials.mcp.json
#   Per-instance credential file (a .mcp.json holding the memora env block).
#   If unset, the script uses ~/.config/memora/credentials.mcp.json when that
#   file exists, otherwise a host-specific fallback. Use a per-instance file
#   whenever workspaces differ: bestation and re omit the AWS/R2 backup vars
#   that agentic-box and ob1 set, and sharing one file would silently switch
#   cloud backup ON for stores that never had it.
# MEMORA_HEALTH_TIMEOUT=15
# MEMORA_HEALTH_REFRESH_INTERVAL=15
# MEMORA_VECTOR_SCAN_PAGE_SIZE=100
