# The operator's deploy configuration. Copy to instances/deploy.env
# (git-ignored, like instances/*.env) and replace every placeholder.
# Read by scripts/deploy_config.py for scripts/deploy-memora-all.sh,
# scripts/cutover_store.sh, scripts/switch-embedding-host.sh and
# scripts/audit_configs.py. A script refuses to run when a key it needs is
# missing -- it never falls back to a guessed host.
#
# One KEY=VALUE per line; a value may be wrapped in one pair of quotes.
# Nothing is expanded ($VAR, $(...)) or executed.

# ssh name of the host that runs memora-all (deploy, cutover, audit label)
DEPLOY_HOST=deploy-host

# the host address the graph UI is published on (one IPv4, never 0.0.0.0)
DEPLOY_GRAPH_BIND=100.64.0.10

# the memora checkout on DEPLOY_HOST (a leading ~ is expanded there)
DEPLOY_REPO=~/repos/memora

# JSON: registry store name -> the projects that store holds (MEMORA_PROJECTS)
MEMORA_PROJECTS='{"memora":["memora"],"alpha":["alpha"]}'

# scripts/switch-embedding-host.sh only: the old and new OpenAI-compatible bases
EMBEDDING_OLD_URL=http://100.64.0.12:11434/v1
EMBEDDING_NEW_URL=http://100.64.0.11:11434/v1
