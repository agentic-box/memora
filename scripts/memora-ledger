#!/usr/bin/env python3
"""Leader decision ledger and effectiveness report (Item 118; docs/read-ledger.md).

  memora-ledger draft <decision-id> "<provisional decision>" [--store S] [--caller C]
                                                                  (BEFORE the search)
  memora-ledger label <decision-id> unchanged|changed|avoided-repeat|misleading
                      [--memory N ...] [--time-saved "<what lookup it saved>"] "<concrete change or skipped work>"
  memora-ledger audit <decision-id> confirm|reject|relabel <label> "<reason>" [--by NAME]
                      (the reviewer's verdict on a labelled decision; only `relabel` takes a label)
  memora-ledger missed <decision-id> --memory N "<what was missed>"
  memora-ledger read-back --memory N [--created ISO] "<why it was read>"
  memora-ledger report [--since 7d] [--telemetry PATH | --no-telemetry]

The ledger is a local JSONL file, git-ignored: $MEMORA_DECISION_LEDGER, else
<repo>/.ledger/decisions.jsonl. The report joins it with the server's read
telemetry ($MEMORA_READ_LEDGER, --telemetry; the rotated <path>.1 too) by time
window and memory id; it exits non-zero when that file is missing (--no-telemetry
prints a labels-only report). Local files only: no D1, no server. Counts, not bare
percentages. Standard library only.
"""
from __future__ import annotations

import argparse
import json
import math
import os
import random
import sys
from datetime import datetime, timedelta, timezone
from pathlib import Path
from typing import Any, Dict, List, Optional

LABELS = ("unchanged", "changed", "avoided-repeat", "misleading")
SEARCH_TOOLS = ("memory_hybrid_search", "memory_semantic_search", "memory_list")
AUDIT = ("changed", "avoided-repeat", "misleading")
WINS = ("changed", "avoided-repeat")
VERDICTS = ("confirm", "reject", "relabel")
TARGET_DECISIONS = 40   # the decision rule in docs/read-ledger.md
TARGET_WINS = 4
ROOT = Path(__file__).resolve().parent.parent


class LedgerError(Exception):
    pass


def ledger_file() -> Path:
    env = (os.environ.get("MEMORA_DECISION_LEDGER") or "").strip()
    return Path(env) if env else ROOT / ".ledger" / "decisions.jsonl"


def now_utc() -> datetime:
    return datetime.now(timezone.utc)


def iso(dt: datetime) -> str:
    return dt.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%f")[:-3] + "Z"


def parse_ts(s: str) -> datetime:
    dt = datetime.fromisoformat(s.replace("Z", "+00:00"))
    return dt if dt.tzinfo else dt.replace(tzinfo=timezone.utc)


def read_jsonl(path: Path, strict: bool = False) -> List[Dict[str, Any]]:
    out: List[Dict[str, Any]] = []
    try:
        text = path.read_text(encoding="utf-8")
    except FileNotFoundError:
        return out
    for n, line in enumerate(text.splitlines(), 1):
        if not line.strip():
            continue
        try:
            row = json.loads(line)
        except ValueError:
            if strict:
                raise LedgerError(f"{path}:{n}: not JSON")
            continue  # telemetry: a torn last line must not break the report
        if isinstance(row, dict):
            out.append(row)
    return out


def append(path: Path, row: Dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    row = {"ts": iso(now_utc()), **row}
    with open(path, "a", encoding="utf-8") as f:
        f.write(json.dumps(row, ensure_ascii=False) + "\n")


def need_text(text: str, what: str) -> str:
    text = (text or "").strip()
    if not text:
        raise LedgerError(f"{what} must not be empty")
    return text


def need_draft(rows: List[Dict[str, Any]], did: str) -> None:
    if not any(r.get("type") == "draft" and r.get("id") == did for r in rows):
        raise LedgerError(f"no draft for decision {did!r}: write `draft {did} \"...\"` BEFORE the search")


def cmd_draft(args, path: Path) -> str:
    did = need_text(args.decision_id, "decision-id")
    text = need_text(args.text, "the provisional decision")
    rows = read_jsonl(path, strict=True)
    if any(r.get("type") == "draft" and r.get("id") == did for r in rows):
        raise LedgerError(f"decision {did!r} already has a draft (a draft is written once, before the search)")
    row = {"type": "draft", "id": did, "text": text}
    if args.store:
        row["store"] = args.store
    if args.caller:
        row["caller"] = args.caller
    append(path, row)
    return f"draft {did}"


def cmd_label(args, path: Path) -> str:
    if args.label not in LABELS:
        raise LedgerError(f"unknown label {args.label!r} (one of: {', '.join(LABELS)})")
    did = need_text(args.decision_id, "decision-id")
    text = need_text(args.text, "the concrete change or skipped work")
    rows = read_jsonl(path, strict=True)
    need_draft(rows, did)
    row = {"type": "label", "id": did, "label": args.label, "memories": sorted(set(args.memory or [])), "text": text}
    if args.time_saved is not None:
        row["time_saved"] = need_text(args.time_saved, "--time-saved")
    append(path, row)
    return f"label {did} {args.label}"


def cmd_audit(args, path: Path) -> str:
    if args.verdict not in VERDICTS:
        raise LedgerError(f"unknown audit verdict {args.verdict!r} (one of: {', '.join(VERDICTS)})")
    did = need_text(args.decision_id, "decision-id")
    rest = list(args.rest)
    new_label = None
    if args.verdict == "relabel":
        if len(rest) != 2:
            raise LedgerError('relabel takes a label and a reason: audit <id> relabel <label> "<reason>"')
        new_label = rest[0]
        if new_label not in LABELS:
            raise LedgerError(f"unknown label {new_label!r} (one of: {', '.join(LABELS)})")
    elif len(rest) != 1:
        raise LedgerError(f'{args.verdict} takes only a reason: audit <id> {args.verdict} "<reason>"')
    text = need_text(rest[-1], "the reason")
    by = need_text(args.by, "--by") if args.by is not None else None
    rows = read_jsonl(path, strict=True)
    need_draft(rows, did)
    leader = [r for r in rows if r.get("type") == "label" and r.get("id") == did]
    if not leader:
        raise LedgerError(f"decision {did!r} has no label to {args.verdict}: label it first")
    row: Dict[str, Any] = {"type": "audit", "id": did, "verdict": args.verdict, "text": text}
    # confirm/reject name the leader label they judged, so a later relabel by the leader voids a stale confirm
    row["label"] = new_label or leader[-1]["label"]
    if by:
        row["by"] = by
    append(path, row)
    return f"audit {did} {args.verdict}" + (f" {new_label}" if new_label else "")


def cmd_missed(args, path: Path) -> str:
    did = need_text(args.decision_id, "decision-id")
    if not args.memory:
        raise LedgerError("missed needs --memory N")
    text = need_text(args.text, "what was missed")
    rows = read_jsonl(path, strict=True)
    need_draft(rows, did)
    append(path, {"type": "missed", "id": did, "memories": sorted(set(args.memory)), "text": text})
    return f"missed {did}"


def cmd_read_back(args, path: Path) -> str:
    if not args.memory:
        raise LedgerError("read-back needs --memory N")
    text = need_text(args.text, "why it was read")
    row: Dict[str, Any] = {"type": "readback", "memories": sorted(set(args.memory)), "text": text}
    if args.created:
        try:
            row["created"] = iso(parse_ts(args.created))
        except ValueError:
            raise LedgerError(f"--created {args.created!r} is not an ISO timestamp") from None
    append(path, row)
    return "read-back " + ",".join(str(m) for m in row["memories"])


def parse_since(s: str) -> timedelta:
    unit = s[-1:]
    if unit not in "hdw" or not s[:-1].isdigit():
        raise LedgerError(f"--since {s!r}: use <n>h, <n>d or <n>w")
    return timedelta(**{{"h": "hours", "d": "days", "w": "weeks"}[unit]: int(s[:-1])})


def pct_rank(sorted_vals: List[float], p: float) -> float:
    return sorted_vals[max(0, math.ceil(p * len(sorted_vals)) - 1)]


def build_report(rows, telemetry, now, since: Optional[timedelta], seed=None) -> str:
    start = now - since if since else None
    inwin = lambda ts: start is None or parse_ts(ts) >= start  # noqa: E731
    drafts = {r["id"]: r for r in rows if r.get("type") == "draft" and inwin(r["ts"])}
    labels: Dict[str, Dict[str, Any]] = {}
    for r in rows:  # last label wins
        if r.get("type") == "label" and r.get("id") in drafts:
            labels[r["id"]] = r
    audits: Dict[str, Dict[str, Any]] = {}
    for r in rows:  # last audit wins
        if r.get("type") == "audit" and r.get("id") in drafts:
            audits[r["id"]] = r
    # effective label: a relabel audit beats the leader's label; confirm/reject leave it
    eff: Dict[str, str] = {d: l["label"] for d, l in labels.items()}
    for d, a in audits.items():
        if a.get("verdict") == "relabel":
            eff[d] = a["label"]

    def verified(d: str) -> bool:
        a = audits.get(d)
        if eff.get(d) not in WINS or not a:
            return False
        if a["verdict"] == "relabel":
            return True
        return a["verdict"] == "confirm" and a.get("label") == eff[d]
    wins = [d for d in eff if eff[d] in WINS]
    n_verified = sum(1 for d in wins if verified(d))
    n_rejected = sum(1 for d in wins if audits.get(d, {}).get("verdict") == "reject")
    n_unaudited = sum(1 for d in wins if d not in audits)
    n_time = sum(1 for d in drafts if d in labels and labels[d].get("time_saved"))
    missed = [r for r in rows if r.get("type") == "missed" and r.get("id") in drafts]
    readbacks = [r for r in rows if r.get("type") == "readback" and inwin(r["ts"])]
    out: List[str] = []
    w = out.append
    w(f"memora ledger report  window: {'since ' + iso(start) if start else 'all time'}  now: {iso(now)}")
    if telemetry is not None and drafts:
        lo = min(parse_ts(d["ts"]) for d in drafts.values())
        hi = max([parse_ts(l["ts"]) for l in labels.values()] + [now for d in drafts if d not in labels] + [lo])
        if not any("ts" in t and lo <= parse_ts(t["ts"]) <= hi for t in telemetry):
            w(f"WARNING: the telemetry has no line between {iso(lo)} and {iso(hi)} (the decisions' span); "
              f"it may be a stale copy, so the joins below can read 0")
    w("")
    w(f"decisions drafted: {len(drafts)}")
    for lab in LABELS:
        w(f"  {lab}: {sum(1 for v in eff.values() if v == lab)}")
    w(f"  unlabeled: {len(drafts) - len(eff)}")
    w("(labels are effective: a reviewer `relabel` audit beats the leader's label)")
    w(f"verified wins (changed/avoided-repeat, reviewer-confirmed or relabelled to one): {n_verified}")
    w(f"unaudited wins (changed/avoided-repeat, no audit yet): {n_unaudited}")
    w(f"rejected wins (reviewer rejected the leader's label): {n_rejected}")
    w(f"time saved (label carries --time-saved): {n_time} decision(s)")
    for d in sorted(drafts):
        if d in labels and labels[d].get("time_saved"):
            w(f"    {d}: {labels[d]['time_saved']}")
    w(f"progress against the rule: {len(drafts)} of {TARGET_DECISIONS} decisions, "
      f"{n_verified} of {TARGET_WINS} verified wins")
    w("")

    # join: a decision's calls are the telemetry between its draft and its label, narrowed
    # to its --store / --caller when the draft names them
    nomeasure = telemetry is None
    telemetry = telemetry or []
    win: Dict[str, Any] = {d: (parse_ts(drafts[d]["ts"]), parse_ts(l["ts"])) for d, l in labels.items()}
    # every draft has a window: an unlabeled one is still open (until now)
    allwin: Dict[str, Any] = {d: win.get(d, (parse_ts(dr["ts"]), now)) for d, dr in drafts.items()}
    per: Dict[str, List[Dict[str, Any]]] = {}
    for did, (lo, hi) in win.items():
        dr = drafts[did]
        per[did] = [t for t in telemetry if "ts" in t and lo <= parse_ts(t["ts"]) <= hi
                    and (not dr.get("store") or t.get("store") == dr["store"])
                    and (not dr.get("caller") or t.get("caller") == dr["caller"])]
    # a decision is AMBIGUOUS (its matches are not counted as cited/returned) when the telemetry
    # cannot be attributed to it: overlapping decisions without --caller, several stores without
    # --store, several callers without --caller, or a call whose id list was truncated
    amb: Dict[str, List[str]] = {}
    for did, (lo, hi) in win.items():
        why: List[str] = []
        dr = drafts[did]
        # overlapping another decision (labeled or still open) is ambiguous unless BOTH name
        # DIFFERENT callers: one shared caller does not single out one decision
        if any(o != did and allwin[o][0] <= hi and lo <= allwin[o][1]
               and not (dr.get("caller") and drafts[o].get("caller") and dr["caller"] != drafts[o]["caller"])
               for o in allwin):
            why.append("overlaps another decision")
        stores = {t["store"] for t in per[did] if t.get("store")}
        callers = {t["caller"] for t in per[did] if t.get("caller")}
        if not dr.get("store") and len(stores) > 1:
            why.append("reads from stores " + ",".join(sorted(stores)))
        if not dr.get("caller") and len(callers) > 1:
            why.append("reads from callers " + ",".join(sorted(callers)))
        if any(t.get("truncated") for t in per[did]):
            why.append("a read returned more ids than were logged")
        if why:
            amb[did] = why
    NM = "not measured (--no-telemetry)"
    searches = [t for calls in per.values() for t in calls if t.get("tool") in SEARCH_TOOLS]
    lat = sorted(float(t["latency_ms"]) for t in searches if isinstance(t.get("latency_ms"), (int, float)))
    if nomeasure:
        w(f"searches joined to {len(labels)} labeled decision(s): {NM}")
        w(f"search latency ms: {NM}")
    else:
        w(f"searches joined to {len(labels)} labeled decision(s): {len(searches)} per-decision occurrence(s), not unique calls: "
          f"(memory_hybrid_search/memory_semantic_search/memory_list)")
        for did in sorted(per):
            n = sum(1 for t in per[did] if t.get("tool") in SEARCH_TOOLS)
            w(f"  {did}: {n} search(es)" + (" [ambiguous]" if did in amb else ""))
        if lat:
            w(f"search latency ms over {len(lat)} per-decision occurrence(s): p50 {pct_rank(lat, 0.5):g}  p95 {pct_rank(lat, 0.95):g}  max {lat[-1]:g}")
        else:
            w("search latency ms: no joined search calls")
    w("")

    cited_total = cited_returned = returned_total = 0
    for did, lab in labels.items():
        if did in amb:
            continue
        returned = {m["id"] for t in per[did] if not t.get("error") for m in t.get("memories", []) if isinstance(m, dict) and "id" in m}
        cited = set(lab.get("memories") or [])
        cited_total += len(cited)
        cited_returned += len(cited & returned)
        returned_total += len(returned)
    if nomeasure:
        w(f"cited vs returned: {NM}")
    else:
        w(f"cited vs returned over {len(labels) - len(amb)} unambiguous decision(s): {cited_returned} of {cited_total} "
          f"cited memory id(s) were returned by a joined read; {returned_total} distinct-per-decision id(s) returned in all")
        w(f"ambiguous decisions, not counted above: {len(amb)}")
        for did in sorted(amb):
            w(f"  {did}: {'; '.join(amb[did])}")
    w("")

    allreads = [r for r in rows if r.get("type") == "readback"]   # all time: the FIRST read may predate the window
    first: Dict[int, Dict[str, Any]] = {}
    created_of: Dict[int, str] = {}
    for r in sorted(allreads, key=lambda r: r["ts"]):
        for m in r["memories"]:
            first.setdefault(m, r)
            if r.get("created"):
                created_of.setdefault(m, r["created"])
    inwin_mem = sorted({m for r in readbacks for m in r["memories"]})
    w(f"item-record read-backs: {len(readbacks)} event(s) in the window, {len(inwin_mem)} distinct memory id(s)")
    for m in inwin_mem:
        r = first[m]
        before = " (before the window)" if start and parse_ts(r["ts"]) < start else ""
        if m in created_of:
            hrs = (parse_ts(r["ts"]) - parse_ts(created_of[m])).total_seconds() / 3600
            w(f"  memory {m}: first read {hrs:.1f} h after creation{before}")
        else:
            w(f"  memory {m}: first read at {r['ts']} (no --created given){before}")
    w("")
    w(f"misleading: {sum(1 for v in eff.values() if v == 'misleading')}   "
      f"missed: {len(missed)} event(s) on {len({r['id'] for r in missed})} decision(s)")
    w("")

    forced = sorted(d for d, v in eff.items() if v in AUDIT)
    ids = sorted(drafts)
    k = math.ceil(0.2 * len(ids)) if ids else 0
    sample = sorted(random.Random(seed).sample(ids, k)) if k else []
    w(f"audit list for the reviewer: {len(set(forced) | set(sample))} decision id(s)")
    w(f"  every changed/avoided-repeat/misleading ({len(forced)}):")
    for d in forced:
        a = audits.get(d)
        mark = f"  (audited: {a['verdict']}{' by ' + a['by'] if a.get('by') else ''})" if a else ""
        w(f"    {d}  [{eff[d]}] {labels[d]['text']}{mark}")
    w(f"  random sample, ceil(20% of {len(ids)}) = {k}:")
    for d in sample:
        w(f"    {d}  [{eff[d] if d in eff else 'unlabeled'}]")
    return "\n".join(out)


def cmd_report(args, path: Path) -> str:
    since = parse_since(args.since) if args.since else None
    if args.no_telemetry and args.telemetry:
        raise LedgerError("--telemetry and --no-telemetry are mutually exclusive")
    tel: Optional[List[Dict[str, Any]]] = None
    if not args.no_telemetry:
        tpath = args.telemetry or os.environ.get("MEMORA_READ_LEDGER") or str(ROOT / ".ledger" / "read-ledger.jsonl")
        if not (Path(tpath).exists() or Path(tpath + ".1").exists()):
            raise LedgerError(f"no telemetry file at {tpath} (nor {tpath}.1): fetch the server's read ledger and pass "
                              f"--telemetry PATH (docs/read-ledger.md, \"Fetch the telemetry\"), or use --no-telemetry "
                              f"for a labels-only report")
        tel = read_jsonl(Path(tpath + ".1")) + read_jsonl(Path(tpath))
    now = parse_ts(args.now) if args.now else now_utc()
    return build_report(read_jsonl(path, strict=True), tel, now, since, args.seed)


def parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="memora-ledger", description=__doc__.split("\n\n")[0])
    sub = p.add_subparsers(dest="cmd", required=True)
    d = sub.add_parser("draft")
    d.add_argument("decision_id")
    d.add_argument("text")
    d.add_argument("--store", help="attribute only this store's reads to the decision")
    d.add_argument("--caller", help="attribute only reads carrying this X-Memora-Caller")
    lb = sub.add_parser("label")
    lb.add_argument("decision_id")
    lb.add_argument("label")
    lb.add_argument("--memory", type=int, action="append")
    lb.add_argument("--time-saved", help="recall saved lookup time (does not change the label)")
    lb.add_argument("text")
    au = sub.add_parser("audit")
    au.add_argument("decision_id")
    au.add_argument("verdict")
    au.add_argument("rest", nargs="+", metavar="[LABEL] REASON")
    au.add_argument("--by", help="who decided (e.g. ab-reviewer)")
    m = sub.add_parser("missed")
    m.add_argument("decision_id")
    m.add_argument("--memory", type=int, action="append")
    m.add_argument("text")
    r = sub.add_parser("read-back")
    r.add_argument("--memory", type=int, action="append")
    r.add_argument("--created")
    r.add_argument("text")
    rp = sub.add_parser("report")
    rp.add_argument("--since")
    rp.add_argument("--telemetry")
    rp.add_argument("--no-telemetry", action="store_true", help="labels-only report; search/latency/cited-vs-returned are not measured")
    rp.add_argument("--now", help=argparse.SUPPRESS)
    rp.add_argument("--seed", type=int, help=argparse.SUPPRESS)
    return p


def main(argv: Optional[List[str]] = None) -> int:
    args = parser().parse_args(argv)
    handler = {"draft": cmd_draft, "label": cmd_label, "audit": cmd_audit, "missed": cmd_missed,
               "read-back": cmd_read_back, "report": cmd_report}[args.cmd]
    try:
        print(handler(args, ledger_file()))
    except LedgerError as exc:
        print(f"memora-ledger: {exc}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
